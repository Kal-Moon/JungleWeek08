{
    "name": "pintos-dev",
    "dockerFile": "Dockerfile",
    "workspaceMount": "source=${localWorkspaceFolder},target=/workspaces/PintOS,type=bind,consistency=cached",
    "workspaceFolder": "/workspaces/PintOS",
    "remoteUser": "jungle",
    "remoteEnv": {
        "PATH": "/workspaces/PintOS/pintos/utils:${containerEnv:PATH}"
    },
    "customizations": {
        "vscode": {
            "extensions": [
                "ms-vscode.cpptools-extension-pack",
                "ms-vscode.cpptools",
                "ms-azuretools.vscode-docker",
                "ms-vscode.makefile-tools"
            ],
            "settings": {
                "terminal.integrated.defaultProfile.linux": "bash"
            }
        }
    }
}
